    "version_args": ["version"],
    "version_regex": "(\\d+\\.\\d+\\.\\d+)",
    "repo": "koyeb/koyeb-cli",
    "asset_template": "koyeb-cli_{VERSION}_{OS}_{ARCH}.{EXT}",
